package.path ..= package.config[3].."lib/?.pluto":replace("/", package.config[1])

local { crypto, scheduler, socket } = require "*"
local { be_encode, be_decode } = require "bencoding"

local function bt_recv(s)
	local data = s:recv()
	if data and #data >= 4 then
		local len = ">I4":unpack(data)
		data = data:sub(5)
		while #data < len do
			data ..= s:recv(data)
		end
		if #data > len then
			s:unrecv(data:sub(1 + len))
			data = data:sub(1, len)
		end
		return data
	end
end

local function bt_send(s, data)
	return s:send(">s4":pack(data))
end

--[[local demo_info = be_encode({
	name = "lol",
	length = 0x10 * 10000,
	["piece length"] = 0x10,
	pieces = "1337133713371337133713371337133713371337":rep(10000):fromhex()
})

local demo_infohash = crypto.sha1(demo_info, true)

print("magnet:?xt=urn:btih:" .. require"base32".encode(demo_infohash) .. "&x.pe=x.x.x.x:6881")]]

--local cache = setmetatable({}, { __mode = "v" }) -- If caching torrents from HTTP sources, this would make sense, assuming the table values are reference types (tables).

local index = {}
for io.listdir("torrents") as file do
	local data = io.contents(file)
	local metainfo = be_decode(data)
	local info = be_encode(metainfo.info)
	assert(info in data)
	local infohash = crypto.sha1(info, true)
	print("Added "..infohash:tohex().." to index")
	index[infohash] = info
end

local sched = new scheduler()
socket.bind(sched, 6881, |s| -> do
	xpcall(function()
		local handshake = s:recv()
		if handshake and #handshake == 68 and handshake:startswith("\x13BitTorrent protocol") then
			local extensions, infohash, peerid = ">I8c20c20":unpack(handshake, 21)
			peerid = peerid:tohex()
			print(peerid .. " - Connected for infohash " .. infohash:tohex())
			--print(dumpvar($object(extensions, infohash, peerid)))
			local info = index[infohash]
			if info
				--and (extensions & 4) ~= 0 -- BEP 6
				and (extensions & 0x100000) ~= 0 -- BEP 10
			then
				s:send("\x13BitTorrent protocol" .. "\x00\x00\x00\x00\x00\x10\x00\x04" .. infohash .. "pluto-bittorrent\0\0\0\0")
				local ut_metadata
				while data := bt_recv(s) do
					if #data == 0 then
						--print(peerid .. "- Keepalive")
					else
						local msgid = ">I1":unpack(data, 1)
						if msgid == 20 then
							local ext_msgid = ">I1":unpack(data, 2)
							if ext_msgid == 0 then
								local msg = be_decode(data:sub(3))
								--print("Extension protocol handshake: " .. dumpvar(msg))
								if msg.m?.ut_metadata then
									ut_metadata = msg.m.ut_metadata
									--print("client has ut_metadata: " .. tostring(ut_metadata))
									bt_send(s, ">I1I1":pack(20, 0) .. be_encode{
										m = { ut_metadata = ut_metadata },
										metadata_size = #info, -- Providing this field in the handshake implies knowledge of the entire info dict
										v = "magnet-seeder (https://github.com/Sainan/pluto-bittorrent)",
										upload_only = 1, -- Indicate that we will not be downloading anything as per BEP 21
									})
								end
								if not ut_metadata then
									print(peerid .. " - Client doesn't support ut_metadata")
									break
								end
							elseif ext_msgid == ut_metadata then
								local msg = be_decode(data:sub(3))
								--print("ut_metadata message: " .. dumpvar(msg))
								if msg.msg_type == 0 then
									print(peerid .. " - Request for piece " .. msg.piece)
									local offset = msg.piece * 16384
									bt_send(s, ">I1I1":pack(20, ut_metadata) .. be_encode{ msg_type = 1, piece = msg.piece, total_size = #info } .. info:sub(1 + offset, offset + 16384))
								end
							else
								print(peerid .. " - Unhandled extension protocol message: " .. data:tohex())
							end
						else
							print(peerid .. " - Unhandled message: " .. data:tohex())
						end
					end
				end
			end
			print(peerid .. " - Closing")
		end
	end, function(e)
		print(e)
	end)
	s:close()
end)
print("Bound to TCP/6881")
sched:run()

-- @param dicts_have_order fixes the fact that empty lists cannot be produced by this function normally. Note that the given order is not respected as per the bencoding specification.
export function be_encode(data, dicts_have_order)
	if type(data) == "string" then
		return #data .. ":" .. data
	elseif type(data) == "number" then
		return "i" .. data .. "e"
	elseif type(data) == "table" then
		if dicts_have_order ? data.__order : #data == 0 then
			local str = "d"
			local keys = data:keys():sort()
			for keys as key do
				--assert(type(key) == "string")
				if key ~= "__order" then
					str ..= be_encode(key, dicts_have_order)
					str ..= be_encode(data[key], dicts_have_order)
				end
			end
			return str .. "e"
		else
			local str = "l"
			for data as value do
				str ..= be_encode(value, dicts_have_order)
			end
			return str .. "e"
		end
	else
		error("Unexpected type of data: "..type(data))
	end
end

export function be_decode(data, i = 1, with_order)
	if data[i] == "i" then
		local e = data:find("e", i)
		return tonumber(data:sub(i + 1, e - 1)), e + 1
	elseif data[i] == "d" then
		++i
		local t = {}
		if with_order then
			t.__order = {}
		end
		while data[i] ~= "e" do
			local key, value
			key, i = be_decode(data, i, with_order)
			--assert(type(key) == "string")
			value, i = be_decode(data, i, with_order)
			if with_order then
				t.__order:insert(key)
			end
			t[key] = value
		end
		return t, i + 1
	elseif data[i] == "l" then
		++i
		local t = {}
		while data[i] ~= "e" do
			local value
			value, i = be_decode(data, i, with_order)
			t:insert(value)
		end
		return t, i + 1
	else
		local c = data:find(":", i)
		local l = tonumber(data:sub(i, c - 1))
		i = c + 1
		return data:sub(i, i + l - 1), i + l
	end
end

if not arg[1] then
	print("Syntax: pluto maketorrent.pluto <file or folder> [--private] [--pad]")
	return
end

package.path ..= package.config[3].."lib/?.pluto":replace("/", package.config[1])

local { crypto } = require "*"
local { be_encode } = require "bencoding"
local { measure_content_size, torrent_size_to_piece_size } = require "btcommon"

local private = false
local pad = false
for i = 2, #arg do
	switch arg[i] do
		case "--private": private = true break
		case "--pad": pad = true break
	end
end

local content_bytes = measure_content_size(arg[1])
local piece_length = torrent_size_to_piece_size(content_bytes)
--print(content_bytes.." content bytes, using "..piece_length.."-byte pieces.")
local pieces = {}
local info
if io.isdir(arg[1]) then
	local pending_piece = ""
	local files = {}
	local function index_folder(folder_path, pathv_base)
		for io.listdir(folder_path) as path do
			local pathv = pathv_base:clone()
			pathv:insert(io.part(path, "name"))
			if io.isdir(path) then
				index_folder(path, pathv)
			else
				if pad and #pending_piece ~= 0 then
					local pad_len = piece_length - #pending_piece
					pending_piece ..= string.rep("\0", pad_len)
					assert(#pending_piece == piece_length)
					pieces:insert(crypto.sha1(pending_piece, true))
					pending_piece = ""
					files:insert({
						path = { ".pad", tostring(pad_len) },
						length = pad_len,
						attr = "p",
					})
				end
				local fh <close> = io.open(path, "rb")
				local length = 0
				while data := fh:read(piece_length - #pending_piece) do
					length += #data
					pending_piece ..= data
					if #pending_piece == piece_length then
						pieces:insert(crypto.sha1(pending_piece, true))
						pending_piece = ""
					end
				end
				files:insert({
					path = pathv,
					length = length,
				})
			end
		end
	end
	index_folder(arg[1], {})
	if #pending_piece ~= 0 then
		pieces:insert(crypto.sha1(pending_piece, true))
	end
	info = be_encode({
		name = arg[1],
		files = files,
		["piece length"] = piece_length,
		pieces = pieces:concat(""),
		private = private ? 1 : nil,
	})
else
	local fh <close> = io.open(arg[1], "rb")
	local length = 0
	while data := fh:read(piece_length) do
		length += #data
		pieces:insert(crypto.sha1(data, true))
	end
	info = be_encode({
		name = arg[1],
		length = length,
		["piece length"] = piece_length,
		pieces = pieces:concat(""),
		private = private ? 1 : nil,
	})
end
io.contents(arg[1]..".torrent", "d4:info"..info.."e")
print("Created "..arg[1]..".torrent (infohash "..crypto.sha1(info, false)..")")
